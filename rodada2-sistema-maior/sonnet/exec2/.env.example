# Copy this file to .env and adjust values for your environment.

# App
APP_NAME="Clinic Management API"
ENVIRONMENT=development
DEBUG=false

# Database
DATABASE_URL=sqlite:///./clinic.db

# JWT - use a long, random, secret value in production
JWT_SECRET_KEY=change-this-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Security policy
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Billing
CONVENIO_DISCOUNT_PERCENT=20.0

# Bootstrap: creates this admin account on first startup if it doesn't exist yet.
INITIAL_ADMIN_EMAIL=admin@clinica.com
INITIAL_ADMIN_PASSWORD=ChangeMe123!
