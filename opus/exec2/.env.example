# Copie para .env e ajuste. Todas as variáveis são opcionais.

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Sem ela, uma chave aleatória é gerada a cada inicialização (tokens expiram ao reiniciar).
SECRET_KEY=

DATABASE_URL=sqlite:///./library.db
ACCESS_TOKEN_EXPIRE_MINUTES=60
BCRYPT_ROUNDS=12

MAX_ACTIVE_LOANS=3
DEFAULT_LOAN_DAYS=14
MAX_LOAN_DAYS=60
DAILY_FINE=2.00
LIBRARY_TIMEZONE=America/Sao_Paulo
