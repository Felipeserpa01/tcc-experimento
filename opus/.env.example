# Copie para .env e ajuste os valores.
DATABASE_URL=sqlite:///./library.db

# Gere uma chave forte, por exemplo: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-esta-chave-por-uma-chave-aleatoria-e-longa
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Regras de empréstimo
LOAN_PERIOD_DAYS=14
MAX_ACTIVE_LOANS=3
DAILY_FINE=2.00

# Bibliotecário criado automaticamente na inicialização (se ainda não existir)
FIRST_LIBRARIAN_NAME=Administrador
FIRST_LIBRARIAN_EMAIL=admin@biblioteca.com
FIRST_LIBRARIAN_PASSWORD=admin12345
