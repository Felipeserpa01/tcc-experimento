# ---------------------------------------------------------------------------
# Clinica Medica API - exemplo de configuracao.
# Copie para `.env` e ajuste os valores. NUNCA versione o arquivo `.env`.
# ---------------------------------------------------------------------------

# Aplicacao
APP_NAME="Clinica Medica API"
ENVIRONMENT=development           # development | testing | production
DEBUG=true
API_V1_PREFIX=/api/v1
TIMEZONE=America/Sao_Paulo

# Banco de dados
DATABASE_URL=sqlite:///./clinica.db
DATABASE_ECHO=false

# Seguranca (obrigatorio em producao)
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
PASSWORD_MIN_LENGTH=8
# Custo do bcrypt (12 e o minimo em producao; valores menores apenas em teste)
BCRYPT_ROUNDS=12

# Bloqueio de conta
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# Paginacao
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Usuario administrador inicial (criado no boot quando informado)
FIRST_ADMIN_EMAIL=admin@clinica.com.br
FIRST_ADMIN_PASSWORD=Admin@123456
FIRST_ADMIN_NAME=Administrador do Sistema

# Upload de resultados de exames
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.txt,.doc,.docx

# CORS (lista separada por virgula, ou * para liberar tudo)
CORS_ORIGINS=*

# Regras de agendamento
DEFAULT_APPOINTMENT_DURATION_MINUTES=30
