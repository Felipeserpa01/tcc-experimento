# Copie para .env e ajuste os valores. NUNCA versione o arquivo .env.

# Obrigatória: chave de assinatura dos JWT (mínimo 32 caracteres).
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

ENVIRONMENT=development          # development | test | production
LOG_LEVEL=INFO
DOCS_ENABLED=true
# CORS_ORIGINS=["http://localhost:3000"]

DATABASE_URL=sqlite:///./clinica.db

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

BCRYPT_ROUNDS=12
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

TIMEZONE=America/Sao_Paulo
MAX_BOOKING_DAYS_AHEAD=365

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# E-mail (se SMTP_HOST ficar vazio, as mensagens são apenas registradas em log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=nao-responda@clinica.com.br
SMTP_USE_TLS=true

# Administrador criado automaticamente na primeira inicialização (opcional)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=Administrador do Sistema
